{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Sekundär",
	"slug": "secondary",
	"blockTypes": [
		"core/button"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--navy)"
		},
		"border": {
			"color": "var(--wp--preset--color--line)",
			"width": "var(--wp--custom--border-width--thin)",
			"style": "solid"
		},
		":hover": {
			"color": {
				"background": "var(--wp--preset--color--white)",
				"text": "var(--wp--preset--color--navy)"
			},
			"border": {
				"color": "var(--wp--preset--color--navy)"
			}
		}
	}
}
