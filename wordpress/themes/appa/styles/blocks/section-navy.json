{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Abschnitt Navy",
	"slug": "section-navy",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--navy)",
			"text": "var(--wp--preset--color--white)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--white)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--white)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--gold)"
					}
				}
			}
		}
	}
}
