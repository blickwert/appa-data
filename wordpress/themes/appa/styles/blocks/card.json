{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Karte",
	"slug": "card",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)"
		},
		"border": {
			"color": "var(--wp--preset--color--line)",
			"width": "var(--wp--custom--border-width--thin)",
			"style": "solid",
			"radius": "var(--wp--custom--radius--lg)"
		},
		"spacing": {
			"padding": {
				"top": "var(--wp--preset--spacing--7)",
				"bottom": "var(--wp--preset--spacing--7)",
				"left": "var(--wp--preset--spacing--7)",
				"right": "var(--wp--preset--spacing--7)"
			}
		},
		"shadow": "var(--wp--preset--shadow--card)"
	}
}
