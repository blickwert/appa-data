{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bw/icon",
	"title": "Icon",
	"category": "design",
	"icon": "star-filled",
	"description": "Ein Symbol aus dem APPA-Icon-Set.",
	"textdomain": "appa",
	"attributes": {
		"icon": { "type": "string", "default": "sparkles" },
		"size": { "type": "string", "enum": [ "s", "m", "l" ], "default": "m" },
		"tone": { "type": "string", "enum": [ "red", "navy", "green", "gold", "blue" ], "default": "red" },
		"shape": { "type": "string", "enum": [ "plain", "circle", "square", "tile" ], "default": "plain" }
	},
	"supports": { "html": false, "spacing": { "margin": true } },
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
