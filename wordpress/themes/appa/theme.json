{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "47.5rem",
			"wideSize": "69rem"
		},
		"color": {
			"palette": [
				{
					"slug": "red",
					"name": "Rot (Primär)",
					"color": "#D93629"
				},
				{
					"slug": "red-dark",
					"name": "Rot dunkel (Hover)",
					"color": "#BF2C20"
				},
				{
					"slug": "navy",
					"name": "Navy (Text)",
					"color": "#12345A"
				},
				{
					"slug": "slate",
					"name": "Schiefer (Fließtext)",
					"color": "#52677A"
				},
				{
					"slug": "gold",
					"name": "Gold (Akzent)",
					"color": "#E9B434"
				},
				{
					"slug": "gold-text",
					"name": "Gold Text",
					"color": "#9F6D00"
				},
				{
					"slug": "green",
					"name": "Grün",
					"color": "#77AA41"
				},
				{
					"slug": "on-green",
					"name": "Text auf Grün",
					"color": "#343434"
				},
				{
					"slug": "blue",
					"name": "Blau (Fokus)",
					"color": "#328AC9"
				},
				{
					"slug": "sky",
					"name": "Hellblau",
					"color": "#EAF3F8"
				},
				{
					"slug": "mist",
					"name": "Grau hell",
					"color": "#F4F7F8"
				},
				{
					"slug": "line",
					"name": "Rahmen",
					"color": "#D7E3EA"
				},
				{
					"slug": "white",
					"name": "Weiß",
					"color": "#FFFFFF"
				}
			],
			"gradients": [
				{
					"slug": "brand",
					"name": "Markenverlauf",
					"gradient": "linear-gradient(135deg,#D93629 0%,#E9B434 100%)"
				},
				{
					"slug": "logo-stripe",
					"name": "Logo-Streifen",
					"gradient": "linear-gradient(90deg,#D93629 0 25%,#328AC9 25% 50%,#77AA41 50% 75%,#E9B434 75% 100%)"
				}
			],
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"duotone": [],
			"link": true
		},
		"typography": {
			"fluid": {
				"minViewportWidth": "360px",
				"maxViewportWidth": "69rem"
			},
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": false,
			"textDecoration": false,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "Mini",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "sm",
					"name": "Klein",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "base",
					"name": "Text",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "lg",
					"name": "Lead",
					"size": "1.125rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "xl",
					"name": "Zwischentitel",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "H2 klein",
					"size": "1.5rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "xxx-large",
					"name": "H2",
					"size": "1.875rem",
					"fluid": {
						"min": "1.5rem",
						"max": "1.875rem"
					}
				},
				{
					"slug": "huge",
					"name": "H1",
					"size": "3rem",
					"fluid": {
						"min": "2rem",
						"max": "3rem"
					}
				},
				{
					"slug": "display",
					"name": "H1 Hero",
					"size": "3.75rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.75rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"rem",
				"%"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "1",
					"name": "4px",
					"size": "0.25rem"
				},
				{
					"slug": "2",
					"name": "8px",
					"size": "0.5rem"
				},
				{
					"slug": "3",
					"name": "12px",
					"size": "0.75rem"
				},
				{
					"slug": "4",
					"name": "16px",
					"size": "1rem"
				},
				{
					"slug": "5",
					"name": "20px",
					"size": "1.25rem"
				},
				{
					"slug": "6",
					"name": "24px",
					"size": "1.5rem"
				},
				{
					"slug": "7",
					"name": "28px",
					"size": "1.75rem"
				},
				{
					"slug": "8",
					"name": "32px",
					"size": "2rem"
				},
				{
					"slug": "10",
					"name": "40px",
					"size": "2.5rem"
				},
				{
					"slug": "12",
					"name": "48px",
					"size": "3rem"
				},
				{
					"slug": "16",
					"name": "64px",
					"size": "4rem"
				},
				{
					"slug": "20",
					"name": "80px",
					"size": "5rem"
				},
				{
					"slug": "section",
					"name": "Abschnitt",
					"size": "clamp(3rem, 2.0323rem + 4.3011vw, 5rem)"
				},
				{
					"slug": "gutter",
					"name": "Seitenrand",
					"size": "clamp(1rem, 0.7581rem + 1.0753vw, 1.5rem)"
				}
			],
			"customSpacingSize": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "card",
					"name": "Karte",
					"shadow": "0 4px 6px -1px rgb(15 23 42 / 0.10), 0 2px 4px -2px rgb(15 23 42 / 0.10)"
				},
				{
					"slug": "raised",
					"name": "Erhöht",
					"shadow": "0 10px 30px -8px rgb(15 23 42 / 0.12)"
				}
			]
		},
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"custom": {
			"radius": {
				"sm": "0.375rem",
				"md": "0.5rem",
				"lg": "0.75rem",
				"pill": "999px"
			},
			"border-width": {
				"thin": "1px",
				"thick": "2px"
			},
			"line-height": {
				"tight": 1.1,
				"heading": 1.2,
				"snug": 1.4,
				"body": 1.6,
				"relaxed": 1.75
			},
			"letter-spacing": {
				"eyebrow": "0.1em",
				"label": "0.05em"
			},
			"transition": "150ms ease",
			"layout": {
				"dashboard": "77rem"
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": false
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--slate)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--6)",
			"padding": {
				"left": "var(--wp--preset--spacing--gutter)",
				"right": "var(--wp--preset--spacing--gutter)"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xl)",
					"lineHeight": "1.4"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--base)",
					"lineHeight": "1.4"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--red-dark)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--navy)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--blue)",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--red)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--lg)",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--3)",
						"bottom": "var(--wp--preset--spacing--3)",
						"left": "var(--wp--preset--spacing--5)",
						"right": "var(--wp--preset--spacing--5)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sm)",
					"fontWeight": "600",
					"lineHeight": "1.4",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--red-dark)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--blue)",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--slate)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sm)"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sm)",
					"fontWeight": "600"
				},
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--red)"
							}
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xl)",
					"fontWeight": "700"
				},
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--navy)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/quote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				"border": {
					"width": "0"
				},
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--sm)",
							"fontWeight": "400",
							"fontStyle": "normal"
						},
						"color": {
							"text": "var(--wp--preset--color--slate)"
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--line)"
				},
				"border": {
					"width": "1px"
				}
			},
			"core/list": {
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--5)"
					}
				}
			},
			"core/details": {
				"border": {
					"bottom": {
						"color": "var(--wp--preset--color--line)",
						"width": "1px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--4)",
						"bottom": "var(--wp--preset--spacing--4)"
					}
				}
			},
			"core/post-title": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--navy)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--red)"
							}
						}
					}
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--radius--lg)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "header-member",
			"title": "Header Mitgliederbereich (Login)",
			"area": "header"
		},
		{
			"name": "footer-member",
			"title": "Footer Mitgliederbereich",
			"area": "footer"
		},
		{
			"name": "header-dashboard",
			"title": "Header Mitgliederbereich (Übersicht)",
			"area": "header"
		},
		{
			"name": "member-sidebar",
			"title": "Mitgliederbereich: Navigation",
			"area": "uncategorized"
		}
	],
	"customTemplates": [
		{
			"name": "page-full",
			"title": "Seite ohne Titel (Abschnitte)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-member",
			"title": "Mitgliederbereich: Login",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-member-dashboard",
			"title": "Mitgliederbereich: Übersicht",
			"postTypes": [
				"page"
			]
		}
	]
}
